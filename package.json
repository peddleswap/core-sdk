{
  "name": "@peddleswap/sdk",
  "version": "0.1.3",
  "description": "Addresses, ABIs and chain definitions for PeddleSwap on Robinhood Chain, Base, Arc and Sepolia, generated from the deployed contracts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peddleswap/core-sdk.git"
  },
  "homepage": "https://github.com/peddleswap/core-sdk#readme",
  "bugs": {
    "url": "https://github.com/peddleswap/core-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CLAUDE-PROMPT.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "gen:check": "node scripts/gen-check.mjs",
    "build": "npm run gen && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:live": "npm run build && node scripts/verify-live.mjs",
    "prepublishOnly": "npm run gen && npm run typecheck && npm test && tsup"
  },
  "peerDependencies": {
    "viem": "^2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsup": "^8",
    "typescript": "^5",
    "viem": "^2",
    "vitest": "^3"
  },
  "keywords": [
    "peddleswap",
    "robinhood-chain",
    "dex",
    "amm",
    "uniswap",
    "uniswap-v3",
    "viem",
    "ethereum",
    "web3",
    "defi",
    "typescript",
    "abi"
  ],
  "publishConfig": {
    "access": "public"
  }
}
