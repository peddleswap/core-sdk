{
  "name": "@peddleswap/sdk",
  "version": "0.1.0",
  "description": "Addresses, ABIs and chain definitions for PeddleSwap \u00e2\u20ac\u201d a V2 + V3 exchange on Robinhood Chain.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peddles-markets/peddleswap.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/peddles-markets/peddleswap/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/peddles-markets/peddleswap/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "build": "npm run gen && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:live": "npm run build && node scripts/verify-live.mjs",
    "prepublishOnly": "npm run gen && npm run typecheck && npm test && tsup"
  },
  "peerDependencies": {
    "viem": "^2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsup": "^8",
    "typescript": "^5",
    "viem": "^2",
    "vitest": "^3"
  },
  "keywords": [
    "peddleswap",
    "robinhood-chain",
    "dex",
    "uniswap",
    "viem"
  ],
  "publishConfig": {
    "access": "public"
  }
}
